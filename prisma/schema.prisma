generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Post {
  // Giữ nguyên uuid() của cấu trúc cũ để không bị lỗi ID
  id        String   @id @default(uuid()) 
  
  // Ánh xạ (Map) dữ liệu cột cũ sang trường mới
  titleVi   String   @map("title")
  titleEn   String   @default("")
  titleJp   String   @default("")
  
  contentVi String   @db.Text @map("content")
  contentEn String   @db.Text @default("")
  contentJp String   @db.Text @default("")
  
  tag       String?
  images    String   @default("[]")
  createdAt DateTime @default(now())
}

model PageSection {
  id          String   @id @default(uuid())
  sectionKey  String   @unique 
  contentEn   String   @db.Text
  contentVi   String   @db.Text
  contentJp   String   @db.Text
  updatedAt   DateTime @updatedAt
}

model Visit {
  id        String   @id @default(uuid())
  lang      String   // 'vi', 'en', 'jp'
  userAgent String?
  createdAt DateTime @default(now())
}

model ChatLog {
  id        String   @id @default(uuid())
  mode      String   // 'hacker' hoặc 'sakura'
  message   String   @db.Text
  response  String   @db.Text
  createdAt DateTime @default(now())
}

model Guestbook {
  id        String   @id @default(uuid())
  name      String
  message   String   @db.Text
  icon      String   // '🌸', '🍡', '🦊', '⛩️', '🍵'
  row       Int      @default(0)
  col       Int      @default(0)
  createdAt DateTime @default(now())
}